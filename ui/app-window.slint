import { Notification, NotificationInfo, NotificationType } from "components/notification.slint";
export { NotificationInfo }

// Services
import { PreparingPage } from "pages/preparing/preparing.slint";
import { MainPage } from "pages/main/main.slint";

import { State } from "globals/state.slint";
import { PreparingInternal } from "globals/internal/preparing.slint";
import { MainInternal, FilesInternal } from "globals/internal/main.slint";

export {
    State,
    PreparingInternal,
    MainInternal,
    FilesInternal
}

export component MainWindow inherits Window {
    title: "mhserver-client";
    width: 1280px;
    height: 720px;
    background: #2d2a29;

    main_notification := Notification {
        x: root.width - self.width - 20px;
        y: root.height - self.height - 20px;
        hided: true;
    }

    callback update_main_notification <=> main_notification.update;

    PreparingPage {
        width: parent.width;
        height: parent.height;
    }
    MainPage {
        width: parent.width;
        height: parent.height;
    }
}
