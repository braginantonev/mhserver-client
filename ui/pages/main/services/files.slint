//* ----------------- Context Menu ----------------- *//

global ContextMenuInfo {
    out property <bool> target-empty;
    out property <length> target-x;
    out property <length> target-y;

    private property <length> mouse-padding: 5px;

    public function update_info(target_empty: bool, x: length, y: length) {
        self.target-empty = target_empty;
        self.target-x = x + mouse-padding;
        self.target-y = y + mouse-padding;
    }
}

component MenuItem inherits SimpleButton {
    use-native-scale: true;
    hover-additional-width: -2px; // * Change with ContextMenuBackground border-width 
}

component MenuSeparator {
    height: 1px;
    Rectangle {
        width: parent.width - 2px * 2; // * Change with ContextMenuBackground border-width 
        background: gray;
    }
}

component ContextMenu inherits PopupWindow {
    private property <length> element-height: 40px;

    callback create_folder_triggered <=> act_mkdir.clicked;

    width: 200px;
    x <=> ContextMenuInfo.target-x;
    y <=> ContextMenuInfo.target-y;

    back := FieldBackground {
        enabled: true;
        width: parent.width;
        height: parent.height;
    }

    VerticalLayout {
        // Open action
        act_open := MenuItem {
            enabled: !ContextMenuInfo.target-empty;
            height: element-height;
            text: @tr("Open");
            clicked => {
                if FilesInternal.active_file.is-dir {
                    FilesInternal.cd(FilesInternal.active_file.name);
                }
            }
        }

        MenuSeparator {}

        // Download action
        act_download := MenuItem {
            height: element-height;
            text: @tr("Download");
            clicked => {
                FilesInternal.active-file.is-dir ? FilesInternal.download_directory(FilesInternal.active-file.name) : FilesInternal.download_file(FilesInternal.active-file.name);
            }
        }

        act_upload := MenuItem {
            height: element-height;
            text: @tr("Upload files");
            clicked => { FilesInternal.upload_files() }
        }

        // Delete action
        act_delete := MenuItem {
            enabled: !ContextMenuInfo.target-empty;
            height: element-height;
            text: @tr("Delete");
            clicked => { FilesInternal.active-file.is-dir ? FilesInternal.rmdir(FilesInternal.active-file.name) : FilesInternal.rmfile(FilesInternal.active-file.name); }
        }

        // Create folder action
        act_mkdir := MenuItem {
            height: element-height;
            text: @tr("Create folder");
        }

        MenuSeparator {}

        // Properties action
        act_properties := MenuItem {
            height: element-height;
            text: @tr("Properties");
            clicked => { debug("properties triggered"); }
        }
    }
}

//* ------------------- Loader ----------------- *//

component LoadData inherits HorizontalLayout {
    in property <LoadFile> info;

    callback cancel_load(string);

    spacing: 10px;

    SimpleButton {
        icon: Assets.close-icon;
        icon-color: whitesmoke;

        hover-additional-width: 10px;

        preferred-width: 12px;
        preferred-height: 12px;

        clicked => { 
            self.enabled = false;
            cancel_load(info.connID);
        }
    }

    // progress animation timer
    Timer {
        interval: 1ms;
        running: true;
        triggered => {
            progress_indicator.progress = info.progress;
            self.running = false;
        }
    }

    dataname := Text {
        text: info.name;
        width: parent.width / 2;
        overflow: elide;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    progress_indicator := ProgressIndicator {
        y: parent.height / 2 - self.height / 2;
        update_duration: FilesSettings.loader-update-interval;
        progress: info.previous;
        color: info.is-upload ? #004bbb : green;
    }
}

component Loader {
    in property <length> start_y;

    private property <length> element_height: 50px;
    private property <bool> have-loads: FilesInternal.load-files.length > 0;
    private property <bool> collapsed: false;

    width: 300px;
    height: 200px;

    y: collapsed ? start_y + main_layout.height - label.height : start_y;

    animate opacity { delay: 200ms; duration: 400ms; }
    animate y { duration: 400ms; easing: ease-out-expo; }

    back := FieldBackground {
        enabled: true;
        width: parent.width;
        height: parent.height + 4px;
    }

    main_layout := VerticalLayout {
        label := MenuItem {
            text: @tr("Load data");
            font-size: 14pt;
            clicked => {
                collapsed = !collapsed;
            }
        }

        MenuSeparator {}

        ScrollView {
            width: parent.width;
            viewport-width: self.width;
            viewport-height: FilesInternal.load-files.length * element_height;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                width: parent.width - 30px;
                padding-right: 20px;

                for data[i] in FilesInternal.load-files: LoadData {
                    spacing: 3px;
                    height: element_height;
                    info: data;

                    cancel_load(id) => {
                        FilesInternal.cancel_load(id);
                    }
                }
            }
        }
    }
    
    upd_timer := Timer {
        interval: FilesSettings.loader-update-interval;
        running: false;
        triggered => {
            FilesInternal.update_load_files()
        }
    }

    states [
        hided when !have-loads: {
            collapsed: true;
            opacity: 0;
            visible: self.opacity > 0;
        }
        showed when have-loads: {
            upd_timer.running: true;
        }
    ]
}

//* ----------------- Service ----------------- *//

component FilesWindow {
    private property <length> tile-width: 100px;
    private property <length> tile-height: 100px;
    private property <length> grid-spacing: 30px;
    private property <int> cols-count: self.width / (tile-width + grid-spacing);
    private property <int> rows: Math.ceil(FilesInternal.showed-files.length / cols-count);
    private property <int> rows-in-win: (files_layout.height - files_layout.padding-top) / (tile-height + files_layout.spacing);

    callback context-triggered(string, length, length); // filename, mouse-x, mouse-y
    callback selected(File); // file

    scroll := ScrollView {
        viewport-width: self.width;
        viewport-height: files_layout.height;
        horizontal-scrollbar-policy: always-off;

        files_layout := GridLayout {
            y: 0px;
            padding-top: 10px;
            padding-left: 10px;
            spacing: 30px;
            height: rows * (tile-height + self.spacing);

            for file[i] in FilesInternal.showed-files: FileCeil {
                col: i.mod(cols-count);
                row: i / cols-count;
                    
                height: tile-height;
                width: tile-width;
                file-icon: file.icon;
                name: file.name;

                selected => {
                    FilesInternal.active-file = file;
                    root.selected(file)
                }

                opened() => { 
                    if file.is-dir {
                        FilesInternal.cd(file.name);
                    }
                    // Todo: else - preview file
                }

                context-triggered => {
                    self.selected();
                    root.context-triggered(self.name, self.x + self.mouse-x + scroll.viewport-x, self.y + self.mouse-y + scroll.viewport-y);
                }
            }
        }
    } 
}

export component FilesServiceField inherits FieldBackground {
    TouchArea {
        width: parent.width;
        height: parent.height;
        
        /*clicked => {
            extender.hide();
        }*/

        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                ContextMenuInfo.update_info(true, self.x + self.mouse-x, self.y + self.mouse-y);
                context_menu.show();
            }
        }
    }

    VerticalLayout {
        spacing: 10px;
        padding-top: 15px;
        padding-left: 10px;

        current_dir := Text {
            text: "> " + FilesInternal.current-directory + (FilesInternal.active-file.is-dir ? "" : FilesInternal.active-file.name);
            vertical-alignment: center;
            font-size: 18px;
        }

        MenuSeparator {}

        files_win := FilesWindow {
            /*selected(f) => { extender.show_file(f); }*/
            context-triggered(filename, x, y) => {
                if filename != ".." {
                    ContextMenuInfo.update_info(false, x, y);
                    context_menu.show();
                }
            }
        } 
    }
    
    context_menu := ContextMenu {
        create_folder_triggered => {
            filename_input.show();
        }
    }

    filename_input := FolderNameInput {
        x: parent.width / 2 - self.width / 2;
        y: parent.height / 2 - self.height / 2;
        accepted(name) => {
            FilesInternal.mkdir(name);
        }
    }

    // extender := FileExtender {
    //     y: parent.height - self.height;
    // }

    data_loader := Loader {
        x: parent.width - self.width - 50px;
        start_y: parent.height - self.height;
    }
}